{
  "name": "fire-tools",
  "version": "2.4.11",
  "description": "FIRE tools including calculator with Monte Carlo simulations and asset allocation manager",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "bump-version": "node scripts/bump-version.mjs",
    "dev": "vite",
    "predev": "node scripts/stop-dev.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "stop": "node scripts/stop-dev.mjs",
    "build": "rm -rf dist && tsc && vite build",
    "build:self-hosted": "npm run build -- --mode self-hosted",
    "postbuild": "node scripts/build-landing.mjs && node scripts/build-docs.mjs",
    "build:electron": "tsc && vite build --mode electron && npm ci --prefix server && npm --prefix server run build && node scripts/ensure-native-modules.mjs && node scripts/gen-build-meta.mjs",
    "build:landing": "node scripts/build-landing.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "docs:screenshots": "node scripts/take-screenshots.mjs",
    "preview": "vite preview",
    "pretest": "node scripts/ensure-sqlite-for-node.cjs",
    "test": "vitest run --coverage --reporter=default --reporter=json --outputFile=test-results.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "postinstall": "node scripts/ensure-electron.mjs && node scripts/ensure-native-modules.mjs",
    "electron:rebuild": "node scripts/ensure-native-modules.mjs",
    "preelectron:dev": "node scripts/stop-dev.mjs && node scripts/ensure-electron.mjs && node scripts/ensure-native-modules.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "preelectron:dev:full": "node scripts/stop-dev.mjs && node scripts/ensure-electron.mjs && node scripts/ensure-native-modules.mjs",
    "electron:dev:full": "node scripts/dev-electron-stack.mjs",
    "electron:build": "npm run build:electron",
    "electron:dist": "npm run build:electron && electron-builder --config electron-builder.yml"
  },
  "keywords": [
    "fire",
    "calculator",
    "financial-independence",
    "monte-carlo"
  ],
  "author": {
    "name": "Fire Tools Contributors",
    "email": "noreply@mb-consulting.dev",
    "url": "https://github.com/fire-tools-inc/app"
  },
  "homepage": "https://github.com/fire-tools-inc/app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fire-tools-inc/app.git"
  },
  "bugs": {
    "url": "https://github.com/fire-tools-inc/app/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "marked": "^18.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@llamaindex/liteparse": "^2.17.0",
    "@testing-library/dom": "^10.4.2",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "i18next": "^26.5.10",
    "js-cookie": "^3.0.7",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-is": "^19.3.1",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6",
    "brace-expansion": "5.0.12",
    "filelist": "2.0.2",
    "glob": "13.0.6",
    "global-agent": "4.1.3",
    "js-yaml": "4.3.2",
    "electron-updater": {
      "lodash.isequal": "npm:fast-deep-equal@3.1.3"
    },
    "temp": {
      "rimraf": "4.4.1"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "better-sqlite3-multiple-ciphers@13.0.3": true,
    "fsevents@2.3.3": true
  }
}
